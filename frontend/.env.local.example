# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# FastAPI base URL (no trailing slash). Chat and document calls use this directly;
# Next.js rewrites /api/* here for same-origin fetches. Default: http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=
